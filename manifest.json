{
  "manifest_version": 3,
  "name": "Auto Text Expander",
  "short_name": "TextExpander",
  "version": "1.0.0",
  "description": "Tự động mở rộng từ khóa phím tắt thành văn bản, hỗ trợ định dạng Markdown, lọc theo URL và kiểm tra trước khi lưu.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Auto Text Expander",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/marked.min.js",
        "lib/purify.min.js",
        "content/content.js",
        "content/macro-recorder.js",
        "content/macro-replayer.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Mở popup Auto Text Expander"
    }
  }
}
